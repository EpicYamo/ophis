/* Ophis on Windows: the same dark surface and Razer-green accent as GTK. */

QMainWindow, QWidget#root {
    background-color: #141416;
    color: #f2f2f2;
}

QWidget {
    color: #f2f2f2;
    font-family: "Segoe UI Variable Display", "Segoe UI", "Inter", sans-serif;
    font-size: 13px;
}

QFrame#sidebar {
    background-color: #1a1a1d;
    border-right: 1px solid rgba(255, 255, 255, 0.06);
}

QLabel#brand {
    color: #44d62c;
    font-size: 22px;
    font-weight: 800;
}

QLabel#model {
    color: rgba(255, 255, 255, 0.42);
    font-size: 11px;
}

QLabel[muted="true"] {
    color: rgba(255, 255, 255, 0.45);
    font-size: 12px;
}

QLabel#pageTitle {
    font-size: 25px;
    font-weight: 700;
}

QLabel#pageSubtitle {
    color: rgba(255, 255, 255, 0.45);
    font-size: 13px;
}

QLabel#sectionTitle {
    color: rgba(255, 255, 255, 0.38);
    font-size: 11px;
    font-weight: 600;
}

QLabel#effectTitle {
    font-size: 16px;
    font-weight: 700;
}

QFrame#card {
    background-color: #202024;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
}

QFrame#banner {
    background-color: rgba(255, 170, 60, 0.10);
    border: 1px solid rgba(255, 170, 60, 0.35);
    border-radius: 10px;
}

QFrame#separator {
    background-color: rgba(255, 255, 255, 0.06);
    max-height: 1px;
    min-height: 1px;
}

QPushButton {
    background-color: #2a2a2f;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 7px 14px;
    color: #f2f2f2;
}

QPushButton:hover {
    background-color: #303036;
}

QPushButton:pressed {
    background-color: #26262b;
}

QPushButton:disabled {
    color: rgba(255, 255, 255, 0.25);
    background-color: #242428;
}

QPushButton#accent {
    background-color: #44d62c;
    border: none;
    color: #0d1a0a;
    font-weight: 700;
}

QPushButton#accent:hover {
    background-color: #5ae842;
}

QPushButton#navButton {
    background: transparent;
    border: none;
    border-radius: 10px;
    color: rgba(255, 255, 255, 0.70);
    padding: 10px 14px;
    text-align: left;
    font-size: 13px;
}

QPushButton#navButton:hover {
    background-color: rgba(255, 255, 255, 0.05);
    color: #ffffff;
}

QPushButton#navButton:checked {
    background-color: rgba(68, 214, 44, 0.14);
    color: #ffffff;
}

QPushButton#profileCard {
    background-color: #202024;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    padding: 14px;
    color: rgba(255, 255, 255, 0.75);
    font-weight: 600;
}

QPushButton#profileCard:hover {
    background-color: #26262b;
}

QPushButton#profileCard:checked {
    background-color: rgba(68, 214, 44, 0.16);
    border: 1px solid #44d62c;
    color: #ffffff;
}

QPushButton#segment {
    background: transparent;
    border: none;
    border-radius: 7px;
    padding: 7px 16px;
    color: rgba(255, 255, 255, 0.55);
    font-weight: 600;
}

QPushButton#segment:hover {
    color: #ffffff;
}

QPushButton#segment:checked {
    background-color: #2c2c31;
    color: #ffffff;
}

QFrame#segmentBar {
    background-color: #1c1c20;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 9px;
}

QListWidget#effectList {
    background: transparent;
    border: none;
    outline: none;
    padding: 0;
}

QListWidget#effectList::item {
    color: rgba(255, 255, 255, 0.72);
    border-radius: 8px;
    padding: 9px 12px;
    margin: 2px 0;
}

QListWidget#effectList::item:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

QListWidget#effectList::item:selected {
    background-color: rgba(68, 214, 44, 0.15);
    color: #ffffff;
}

QComboBox {
    background-color: #2a2a2f;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 5px 10px;
    padding-right: 26px;
    min-height: 24px;
}

QComboBox:hover {
    border-color: rgba(255, 255, 255, 0.16);
}

QComboBox:disabled {
    color: rgba(255, 255, 255, 0.30);
    background-color: #242428;
}

QComboBox QAbstractItemView {
    background-color: #202024;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 8px;
    selection-background-color: rgba(68, 214, 44, 0.18);
    selection-color: #ffffff;
    padding: 4px;
}

QSlider::groove:horizontal {
    height: 4px;
    background: #2f2f35;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #44d62c;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #f2f2f2;
    width: 14px;
    margin: -6px 0;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: #ffffff;
}

QSlider::sub-page:horizontal:disabled {
    background: #3a3a40;
}

QSlider::handle:horizontal:disabled {
    background: #66666d;
}

QScrollArea {
    border: none;
    background: transparent;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 9px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #3a3a40;
    border-radius: 3px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #4a4a52;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 9px;
}

QScrollBar::handle:horizontal {
    background: #3a3a40;
    border-radius: 3px;
}

QMenu {
    background-color: #202024;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    padding: 7px 22px 7px 14px;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: rgba(68, 214, 44, 0.16);
}

QToolTip {
    background-color: #26262b;
    color: #f2f2f2;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 6px;
    padding: 5px 8px;
}

QLabel#toast {
    background-color: #2a2a2f;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 10px;
    padding: 10px 16px;
    color: #f2f2f2;
}
