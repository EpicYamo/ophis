# Razer Blade 14 (2022) RZ09-0427 - 1532:028C
# Kontrol arayuzune (vendor-defined usage page 0xFF00) oturum sahibinin
# parolasiz erismesini saglar. Daemon root calisacaksa bu kural sadece
# gelistirme/test icin gereklidir.
#
# Kurulum:
#   sudo cp 99-razer-hidraw.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#   # cihazi yeniden takmak gerekmez, kural aninda uygulanir
#   # dogrulama:
#   ls -l /dev/hidraw*   -> 1532:028c dugumu crw-rw-r--+ ... olmali

KERNEL=="hidraw*", ATTRS{idVendor}=="1532", ATTRS{idProduct}=="028c", TAG+="uaccess", MODE="0660"
